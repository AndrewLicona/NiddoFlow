# ─────────────────────────────────────────────────────────────
# NiddoFlow — Variables de entorno para Dockploy (TEMPLATE)
# Copia este bloque en: Dockploy → tu aplicación → Environment Variables
# Reemplaza los placeholders por los valores reales.
# ─────────────────────────────────────────────────────────────

# ── Supabase · Frontend (Auth público) ───────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_TU_ANON_KEY

# ── Supabase · Backend (service role, NO exponer al browser) ─
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_KEY=sb_secret_TU_SERVICE_ROLE_KEY

# ── Base de datos (Prisma → pooler de Supabase) ─────────────
# Puerto 6543 = pooler transaccional (pgbouncer). No usar 5432.
DATABASE_URL=postgresql://postgres.TU_REF:y4YslQntCbweNTxq@aws-1-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true

# ── URLs públicas ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://TU-DOMINIO/api
NEXT_PUBLIC_BASE_URL=https://TU-DOMINIO
CORS_ORIGINS=https://TU-DOMINIO

# ── OCR / IA (Gemini) ───────────────────────────────────────
# Múltiples keys separadas por coma para rotación automática.
OCR_PROVIDER=gemini
GEMINI_API_KEY=AIzaSyTU_KEY_1,AIzaSyTU_KEY_2

# ── Opcionales ───────────────────────────────────────────────
INTERNAL_API_URL=http://backend:8100
ALLOW_SEED_DATA=false
